<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml — JSON snapshots ride along with the database as a version-independent
     fallback for both cloud restore and direct device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
